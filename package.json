{
  "name": "understory-node",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Understory — a local-first, consent-based knowledge exchange node for real-world communities",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Archaejon/KnowledgeWeb#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archaejon/KnowledgeWeb.git"
  },
  "bugs": {
    "url": "https://github.com/Archaejon/KnowledgeWeb/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "local-first",
    "consent",
    "knowledge-exchange",
    "communities",
    "react"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
